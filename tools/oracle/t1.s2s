var a%, b%, s%, i%, c%, x, y, z;
a% := 7 - 3*2;
s% := 0;
for i% := 1 to 10 do s% += i% next;
b% := 4;
c% := 0;
while b% > 0 do b% -= 1; c% += 2 wend;
x := 1.5;
y := x*2 - 0.25;
z := 0;
for x := 1 to 0 step -0.25 do z += x next;
var f%;
f% := FileOpen("C:\\Users\\Hilal\\Documents\\Spike8\\t1.bin", 9, 1);
BWrite(a%, b%, s%, i%, c%);
BWrite(x, y, z);
FileClose();
