var res[400];
proc Enc(s$, at%)
  var j%;
  res[at%] := Len(s$);
  for j% := 1 to Len(s$) do res[at% + j%] := Asc(Mid$(s$, j%, 1)) next
end;
Enc(Date$(), 0); Enc(Date$(0), 30); Enc(Date$(1,1,1,1,"-"), 60); Enc(Date$(2,2), 90); Enc(Date$(3,3,3), 120); Enc(Date$(0,0,0,0,":"), 150);
Enc(Date$(1), 180); Enc(Date$(2,1,0,1), 210); Enc(Date$(1,2,3,0,"."), 240); Enc(Date$(3,0,0,3), 270);
