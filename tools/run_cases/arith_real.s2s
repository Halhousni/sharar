var res[16], x, y;
x := 7.5; y := 2;
res[0] := x + y; res[1] := x - y; res[2] := x * y; res[3] := x / y;
res[4] := x mod y; res[5] := -x mod y; res[6] := x > y; res[7] := x = 7.5;
res[8] := -x; res[9] := not x; res[10] := x and y; res[11] := x or 0;
res[12] := 1/3; res[13] := 10 / 4; res[14] := 2.5e3 + 1; res[15] := 0.1 + 0.2;
