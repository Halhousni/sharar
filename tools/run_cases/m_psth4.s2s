var res[300], h%, r%, p%, k%, i%, n%;
h% := FileOpen("C:\\Users\\Hilal\\Documents\\Spike8\\data\\Demo.smr", 0, 0);
k% := 0;
r% := SetPower(1, 256, 1);
res[k%] := r%; k% += 1;
res[k%] := ViewKind(r%); k% += 1;
p% := Process(0.0, 5.0);
res[k%] := p%; k% += 1;
res[k%] := Sweeps(); k% += 1;
res[k%] := MaxTime(); k% += 1;
res[k%] := BinSize(); k% += 1;
