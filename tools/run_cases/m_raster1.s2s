var res[400], h%, r%, p%, k%, i%, n%, sT, eT, tick, d[50], di%[50], j%, e3[3], e2[2];
h% := FileOpen("C:\\Users\\Hilal\\Documents\\Spike8\\data\\Demo.smr", 0, 0);
k% := 0;
r% := SetPSTH(3, 20, 0.01, 0.05, 2, 2);
p% := Process(0.0, 20.0);
res[k%] := p%; k% += 1;
n% := RasterGet(1);
res[k%] := n%; k% += 1;
for i% := 1 to 4 do
  res[k%] := RasterGet(1, i%, sT, d[], tick, eT); k% += 1;
  res[k%] := sT; k% += 1;
  res[k%] := eT; k% += 1;
  res[k%] := tick; k% += 1;
  for j% := 0 to 2 do res[k%] := d[j%]; k% += 1; next
next
res[k%] := RasterGet(1, 2, sT, di%[], tick); k% += 1;
for j% := 0 to 2 do res[k%] := di%[j%]; k% += 1; next
res[k%] := RasterSort(1, 1, 1); k% += 1;
res[k%] := RasterSort(1, 1, 1, 3.5); k% += 1;
res[k%] := RasterSort(1, 1, 1); k% += 1;
res[k%] := RasterSort(1, 2, 2, -7); k% += 1;
res[k%] := RasterSort(1, 2, 2); k% += 1;
res[k%] := RasterSymbol(1, 1, 1); k% += 1;
res[k%] := RasterSymbol(1, 1, 1, 12.5); k% += 1;
res[k%] := RasterSymbol(1, 1, 1); k% += 1;
res[k%] := RasterSymbol(1, 3, 8, 1.25); k% += 1;
res[k%] := RasterSymbol(1, 3, 8); k% += 1;
res[k%] := RasterAux(1, 4, 0, 9); k% += 1;
res[k%] := RasterAux(1, 4, 0); k% += 1;
res[k%] := RasterAux(1, 4, 3, 2.5); k% += 1;
res[k%] := RasterSymbol(1, 4, 1); k% += 1;
e3[0] := 0.001; e3[1] := 0.003; e3[2] := 0.007; e2[0] := 0.002; e2[1] := 0.004;
res[k%] := RasterSet(1, 0, 100.0, e3[]); k% += 1;
res[k%] := RasterGet(1); k% += 1;
res[k%] := Sweeps(); k% += 1;
res[k%] := RasterGet(1, n% + 1, sT, d[], tick, eT); k% += 1;
res[k%] := sT; k% += 1;
res[k%] := RasterSet(1, 1, 5.0, e2[]); k% += 1;
res[k%] := RasterGet(1, 1, sT, d[]); k% += 1;
res[k%] := sT; k% += 1;
res[k%] := d[0]; k% += 1; res[k%] := d[1]; k% += 1;
