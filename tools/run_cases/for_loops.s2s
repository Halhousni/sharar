var res[10], i%, s%, j, t;
for i% := 1 to 10 do s% += i% next; res[0] := s%; res[1] := i%;
s% := 0; for i% := 10 to 1 step -3 do s% += i% next; res[2] := s%; res[3] := i%;
t := 0; for j := 0 to 1 step 0.25 do t += j next; res[4] := t; res[5] := j;
s% := 0; for i% := 5 to 1 do s% += 1 next; res[6] := s%; res[7] := i%;
s% := 0; for i% := 1 to 3 do var k%; for k% := 1 to i% do s% += 1 next next; res[8] := s%;
s% := 0; for i% := 1 to 10 do if i% = 4 then break endif s% += i% next; res[9] := s%;
