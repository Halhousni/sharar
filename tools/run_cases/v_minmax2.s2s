var res[200], h%, i%, k%, mn, mx, tn, tx, r%;
h% := FileOpen("C:\\Users\\Hilal\\Documents\\Spike8\\data\\Demo.smr", 0, 0);
k% := 0;
for i% := 0 to 9 do
  r% := MinMax(1, i% * 1.1, i% * 1.1 + 3, mn, mx, tn, tx);
  res[k%] := r%; res[k% + 1] := mn; res[k% + 2] := mx; res[k% + 3] := tn; res[k% + 4] := tx; k% += 5;
next
