var res[200], a[20], b[5][4], h%[8], g%[5], i%, j%, r%, mean, v, sk, ku, under%, over%, k%;
k% := 0;
for i% := 0 to 19 do a[i%] := Sin(i% * 0.7) * 10 + i% * 0.3 next
r% := ArrStats(a[], mean, v, sk, ku);
res[k%] := r%; res[k% + 1] := mean; res[k% + 2] := v; res[k% + 3] := sk; res[k% + 4] := ku; k% += 5;
for i% := 0 to 4 do for j% := 0 to 3 do b[i%][j%] := Cos(i% * 1.3 + j% * 2.1) * (j% + 1) next next
var m4[4], v4[4], s4[4], u4[4];
r% := ArrStats(b[][], m4[], v4[], s4[], u4[]);
res[k%] := r%; k% += 1;
for j% := 0 to 3 do res[k%] := m4[j%]; res[k% + 1] := v4[j%]; res[k% + 2] := s4[j%]; res[k% + 3] := u4[j%]; k% += 4; next
r% := ArrHist(h%[], a[], -10, 3.5);
res[k%] := r%; k% += 1;
for i% := 0 to 7 do res[k%] := h%[i%]; k% += 1; next
under% := 100; over% := 200;
r% := ArrHist(g%[], a[], 0, 2, under%, over%);
res[k%] := r%; res[k% + 1] := under%; res[k% + 2] := over%; k% += 3;
for i% := 0 to 4 do res[k%] := g%[i%]; k% += 1; next
res[k%] := LnGamma(3.5);
