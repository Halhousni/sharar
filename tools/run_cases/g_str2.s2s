var res[512];
proc Enc(s$, at%)
  var i%;
  res[at%] := Len(s$);
  for i% := 1 to Len(s$) do res[at% + i%] := Asc(Mid$(s$, i%, 1)) next
end;
Enc(Str$(3.14159, 1), 0);
Enc(Str$(3.14159, 4), 32);
Enc(Str$(3.14159, 8), 64);
Enc(Str$(3.14159, 12), 96);
Enc(Str$(-2.5, 1), 128);
Enc(Str$(-2.5, 4), 160);
Enc(Str$(-2.5, 8), 192);
Enc(Str$(-2.5, 12), 224);
Enc(Str$(42, 1), 256);
Enc(Str$(42, 4), 288);
Enc(Str$(42, 8), 320);
Enc(Str$(42, 12), 352);
Enc(Str$(1234567.891, 1), 384);
Enc(Str$(1234567.891, 4), 416);
Enc(Str$(1234567.891, 8), 448);
Enc(Str$(1234567.891, 12), 480);
