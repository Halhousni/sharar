var res[400], h%, c%, t, k%, v;
h% := FileOpen("C:\\Users\\Hilal\\Documents\\Spike8\\data\\Demo.smr", 0, 0);
for c% := 1 to 12 do
  t := -1;
  for k% := 0 to 5 do
    t := NextTime(c%, t);
    res[(c% - 1) * 12 + k%] := t;
    if t < 0 then break endif
  next
  res[(c% - 1) * 12 + 6] := LastTime(c%, 1e6);
  res[(c% - 1) * 12 + 7] := Count(c%, 0, 10);
  res[(c% - 1) * 12 + 8] := LastTime(c%, 200);
  res[(c% - 1) * 12 + 9] := NextTime(c%, 200);
  res[(c% - 1) * 12 + 10] := NextTime(c%, 1e6);
  res[(c% - 1) * 12 + 11] := LastTime(c%, 0);
next
FileClose();
