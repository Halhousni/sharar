var res[400], k%, r%, s$, i%, lh%;
proc Enc(s$, at%)
  var j%;
  res[at%] := Len(s$);
  for j% := 1 to Len(s$) do res[at% + j%] := Asc(Mid$(s$, j%, 1)) next
end;
proc Fresh()
  EditSelectAll();
  EditClear();
  Print("abc def abc\nxyz abc\n  tab\there\nlast line");
end;
k% := 0;
lh% := LogHandle();
View(lh%);
Fresh();
res[k%] := MoveTo(1, 1); k% += 1;
res[k%] := MoveBy(3); k% += 1;
res[k%] := MoveBy(2); k% += 1;
res[k%] := MoveBy(-1); k% += 1;
res[k%] := MoveBy(0, 1); k% += 1;
res[k%] := MoveBy(0, -1); k% += 1;
res[k%] := MoveBy(0, 2, 1); k% += 1;
s$ := Selection$(); res[k%] := Len(s$); k% += 1;
res[k%] := MoveTo(2, 3); k% += 1;
res[k%] := MoveBy(2, 0, 1); k% += 1;
s$ := Selection$(); res[k%] := Len(s$); k% += 1;
res[k%] := MoveTo(100, 100); k% += 1;
res[k%] := MoveBy(-1000); k% += 1;
res[k%] := MoveTo(4, 5, 1); k% += 1;
s$ := Selection$(); Enc(s$, 50);
res[k%] := EditFind("abc"); k% += 1;
s$ := Selection$(); res[k%] := Len(s$); k% += 1;
res[k%] := MoveBy(0); k% += 1;
res[k%] := EditFind("abc"); k% += 1;
res[k%] := MoveBy(0); k% += 1;
res[k%] := EditFind("ABC", 0); k% += 1;
res[k%] := EditFind("ABC", 1); k% += 1;
res[k%] := EditFind("zzz"); k% += 1;
res[k%] := EditFind("ab", 2); k% += 1;
res[k%] := EditFind("a.c", 2); k% += 1;
res[k%] := EditFind("[a-z]+", 2); k% += 1;
s$ := Selection$(); Enc(s$, 80);
res[k%] := EditReplace("abc", "Q"); k% += 1;
res[k%] := EditReplace("abc", "Q", 0, 0); k% += 1;
EditSelectAll(); s$ := Selection$(); Enc(s$, 120);
Fresh();
res[k%] := EditReplace("abc", "XYZ", 1); k% += 1;
res[k%] := EditReplace("(a)(b)", "\\2\\1", 2); k% += 1;
EditSelectAll(); s$ := Selection$(); Enc(s$, 200);
res[k%] := TabSettings(); k% += 1;
res[k%] := TabSettings(4); k% += 1;
res[k%] := TabSettings(); k% += 1;
res[k%] := TabSettings(-1, 3); k% += 1;
res[k%] := TabSettings(-1); k% += 1;
res[k%] := TabSettings(8, 0); k% += 1;
Fresh();
EditSelectAll(); res[k%] := EditCopy(); k% += 1;
res[k%] := EditCut(); k% += 1;
EditSelectAll(); s$ := Selection$(); res[k%] := Len(s$); k% += 1;
res[k%] := EditPaste(); k% += 1;
EditSelectAll(); s$ := Selection$(); res[k%] := Len(s$); k% += 1;
