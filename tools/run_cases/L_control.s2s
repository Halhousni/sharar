var res[80], i%, j%, k%, t, s%;
for i% := 1 to 3 do
  for j% := 1 to 3 do
    if j% = 2 then continue endif
    if i% = 3 and j% = 3 then break endif
    s% += i% * 10 + j%;
  next
next
res[0] := s%;
s% := 0; i% := 0;
repeat
  i% += 1;
  if i% mod 2 = 0 then continue endif
  s% += i%;
until i% >= 9;
res[1] := s%;
s% := 0; for t := 1.0 to 2.0 step 0.25 do s% += 1 next res[2] := s%;
i% := 10; while i% > 0 do i% -= 3 wend res[3] := i%;
s% := 0;
for i% := 5 to 1 step -2 do s% += i% next res[4] := s%;
i% := 3;
docase
case i% = 1 then res[5] := 1;
case i% = 3 then res[5] := 3; res[6] := 33;
case i% = 3 then res[5] := 99;
endcase
res[7] := i% > 2 ? 10 : 20;
res[8] := (i% > 5) ? 10 : 20;
res[9] := not 0; res[10] := not 5; res[11] := -(-3);
if i% = 3 then res[12] := 1; else res[12] := 2; endif
if i% <> 3 then res[13] := 1; endif
