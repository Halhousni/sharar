var res[800], k%, i%, n%, t%;
var coef[2047], resp[100], tot;
proc Sum(n%)
  var q%;
  tot := 0.0;
  for q% := 0 to n% - 1 do tot += coef[q%] * (1 + (q% mod 7)) next
end;
k% := 0;
for t% := 0 to 4 do
  n% := FIRQuick(coef[], t%, 0.2);
  Sum(n%);
  res[k%] := n%; res[k%+1] := tot; res[k%+2] := coef[0]; res[k%+3] := coef[n% / 2]; k% += 4;
next
n% := FIRQuick(coef[], 0, 0.1, 0.05, 60);
Sum(n%); res[k%] := n%; res[k%+1] := tot; k% += 2;
n% := FIRQuick(coef[], 2, 0.25, 0.05);
Sum(n%); res[k%] := n%; res[k%+1] := tot; k% += 2;
n% := FIRQuick(coef[], 3, 0.3, 0.1, 40);
Sum(n%); res[k%] := n%; res[k%+1] := tot; k% += 2;
n% := FIRQuick(coef[], 1, 0.15, 0.1, 80);
Sum(n%); res[k%] := n%; res[k%+1] := tot; k% += 2;
FIRResponse(resp[], coef[]);
for i% := 0 to 99 do res[k%] := resp[i%]; k% += 1; next
