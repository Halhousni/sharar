var res[600], h%, k%, i%, j%, n%, s$;
h% := FileOpen("C:\\Users\\Hilal\\Documents\\Spike8\\data\\Demo.smr", 0, 0);
k% := 0;
n% := CursorNew(1.0); res[k%] := n%; k% += 1;
n% := CursorNew(3.0); res[k%] := n%; k% += 1;
s$ := ""; res[k%] := CursorActive(1, 0, s$); res[k%+1] := Len(s$); k% += 2;
for i% := 0 to 1 do
  s$ := "";
  res[k%] := CursorActiveGet(1, i%, s$); res[k%+1] := Len(s$);
  for j% := 1 to Len(s$) do res[k%+1+j%] := Asc(Mid$(s$, j%, 1)); next
  k% += 2 + Len(s$);
next
res[k%] := CursorSearch(1); k% += 1;
res[k%] := CursorSearch(1, 1); k% += 1;
res[k%] := CursorSearch(2, 2); k% += 1;
res[k%] := Cursor(1); res[k%+1] := Cursor(2); k% += 2;
for i% := 0 to 1 do
  s$ := ""; res[k%] := HCursorActive(1, i%, s$); res[k%+1] := Len(s$); k% += 2;
next
