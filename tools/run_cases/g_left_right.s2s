var res[768];
proc Enc(s$, at%)
  var i%;
  res[at%] := Len(s$);
  for i% := 1 to Len(s$) do res[at% + i%] := Asc(Mid$(s$, i%, 1)) next
end;
Enc(Left$("", 0), 0);
Enc(Left$("", 1), 16);
Enc(Left$("", 3), 32);
Enc(Left$("", 50), 48);
