var res[400], k%, i%, j%, r%, n%, it%;
var x[24], y[24], s[24], xm[8][3], w[3], v[3][3], co[4], err, valid%, t, lo, hi;
k% := 0;
for i% := 0 to 23 do x[i%] := i% * 0.25; y[i%] := 1.0 + 2.0 * x[i%] - 0.5 * x[i%] * x[i%] + 0.03 * Sin(i% * 2.1); s[i%] := 0.05 next
' polynomial by FitData
res[k%] := FitData(2, 2); k% += 1;
res[k%] := FitData(1, y[], x[]); k% += 1;
res[k%] := FitCoef(); k% += 1;
for i% := 0 to 2 do res[k%] := FitCoef(i%); k% += 1; next
res[k%] := FitValue(1.5); k% += 1;
res[k%] := FitValue(2.5, valid%); res[k%+1] := valid%; k% += 2;
' an exponential
for i% := 0 to 23 do y[i%] := 2.0 * Exp(-x[i%] / 1.5) + 0.2 + 0.01 * Cos(i% * 1.3) next
res[k%] := FitData(1, -3); k% += 1;
res[k%] := FitCoef(0, 1.8); k% += 1;
res[k%] := FitCoef(1, 1.0); k% += 1;
res[k%] := FitCoef(2, 0.1); k% += 1;
r% := FitData(2, y[], x[], s[], err, 300, it%);
res[k%] := r%; res[k%+1] := err; res[k%+2] := it%; k% += 3;
for i% := 0 to 2 do res[k%] := FitCoef(i%); k% += 1; next
res[k%] := FitValue(2.0); k% += 1;
res[k%] := FitData(0, 0); k% += 1;
' a principal component analysis
for i% := 0 to 7 do for j% := 0 to 2 do xm[i%][j%] := Sin(i% * 0.7 + j% * 1.3) + 0.3 * Cos(i% * 2.9 * (j% + 1)) next next
res[k%] := PCA(1, xm[][], w[], v[][]); k% += 1;
for j% := 0 to 2 do res[k%] := w[j%]; k% += 1; next
for i% := 0 to 2 do for j% := 0 to 2 do res[k%] := v[i%][j%]; k% += 1; next next
for i% := 0 to 7 do for j% := 0 to 2 do res[k%] := xm[i%][j%]; k% += 1; next next
