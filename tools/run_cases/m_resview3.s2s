var res[300], r%, k%, s$, q%;
proc Enc(s$, at%)
  var j%;
  res[at%] := Len(s$);
  for j% := 1 to Len(s$) do res[at% + j%] := Asc(Mid$(s$, j%, 1)) next
end;
k% := 0;
r% := SetResult(20, 0.25, 3.0, "My Title", "sec", "cnt", "XT", "YT");
res[k%] := MaxTime(); k% += 1;
res[k%] := XLow(); k% += 1;
res[k%] := XHigh(); k% += 1;
res[k%] := ChanKind(0); k% += 1;
res[k%] := ChanKind(1); k% += 1;
res[k%] := BinSize(); k% += 1;
res[k%] := BinToX(0); k% += 1;
res[k%] := BinToX(20); k% += 1;
res[k%] := XToBin(3.0); k% += 1;
res[k%] := XToBin(8.1); k% += 1;
res[k%] := XToBin(-1.0); k% += 1;
res[k%] := BinToX(-1); k% += 1;
s$ := WindowTitle$(); Enc(s$, 100);
s$ := ChanTitle$(1); Enc(s$, 120);
s$ := ChanUnits$(1); Enc(s$, 140);
s$ := ChanComment$(1); Enc(s$, 160);
s$ := XTitle$(); Enc(s$, 180);
s$ := XUnits$(); Enc(s$, 200);
s$ := FileName$(0); Enc(s$, 220);
s$ := Chan$(1); Enc(s$, 240);
q% := SetResult(5, 1, 0, "t2", "u2");
res[k%] := MaxTime(); k% += 1;
res[k%] := XLow(); k% += 1;
res[k%] := XHigh(); k% += 1;
res[k%] := ChanKind(1); k% += 1;
s$ := WindowTitle$(); Enc(s$, 260);
res[k%] := q% - r%; k% += 1;
res[k%] := (View() = q%); k% += 1;
res[k%] := FileClose(0, -1); k% += 1;
res[k%] := (View() = r%); k% += 1;
res[k%] := ViewKind(q%); k% += 1;
