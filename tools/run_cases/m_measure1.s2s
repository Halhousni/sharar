k% := 0;
v% := MeasureToXY(7, 1, 0.05, 0.0, 0.1);
res[k%] := v%; k% += 1;
res[k%] := ViewKind(v%); k% += 1;
res[k%] := MeasureX(2, 1, "Cursor(0)", "Cursor(0)+0.01"); k% += 1;
res[k%] := MeasureY(14, 1, "Cursor(0)", "Cursor(0)+0.01"); k% += 1;
res[k%] := MeasureChan(1, "pk"); k% += 1;
res[k%] := Process(0.0, 2.0); k% += 1;
n% := XYCount(1);
res[k%] := n%; k% += 1;
res[k%] := XYGetData(1, x[], y[]); k% += 1;
for i% := 0 to 9 do res[k%] := x[i%]; k% += 1; res[k%] := y[i%]; k% += 1; next
