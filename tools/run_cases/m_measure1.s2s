res[k%] := xl; k% += 1; res[k%] := yl; k% += 1; res[k%] := xh; k% += 1; res[k%] := yh; k% += 1;
c% := MeasureChan(0, "mn", 50);
res[k%] := c%; k% += 1;
res[k%] := MeasureY(15, 1, "Cursor(0)", "Cursor(0)+0.01"); k% += 1;
res[k%] := MeasureChan(2, "mn", 50); k% += 1;
