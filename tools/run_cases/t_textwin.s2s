var res[400], k%, a%, b%, s$, lh%;
proc Enc(s$, at%)
  var j%;
  res[at%] := Len(s$);
  for j% := 1 to Len(s$) do res[at% + j%] := Asc(Mid$(s$, j%, 1)) next
end;
lh% := LogHandle();
k% := 0;
a% := FileNew(1);
res[k%] := a% - lh%; k% += 1;
res[k%] := ViewKind(a%); k% += 1;
res[k%] := (View() = a%); k% += 1;
Print("hello\nworld %d\n", 42);
EditSelectAll();
s$ := Selection$(); Enc(s$, 100);
res[k%] := Len(s$); k% += 1;
b% := FileNew(1);
res[k%] := b% - a%; k% += 1;
Print("second");
EditSelectAll(); s$ := Selection$(); Enc(s$, 130);
View(a%);
EditSelectAll(); s$ := Selection$(); res[k%] := Len(s$); k% += 1;
res[k%] := EditFind("world"); k% += 1;
s$ := Selection$(); Enc(s$, 160);
res[k%] := EditReplace("world", "there", 1); k% += 1;
EditSelectAll(); s$ := Selection$(); Enc(s$, 190);
View(lh%);
Print("to the log\n");
View(b%);
Print(" more");
EditSelectAll(); s$ := Selection$(); Enc(s$, 230);
res[k%] := FileClose(0, -1); k% += 1;
res[k%] := (View() = a%); k% += 1;
res[k%] := View() - a%; k% += 1;
res[k%] := ViewKind(b%); k% += 1;
View(a%);
res[k%] := FileClose(0, -1); k% += 1;
res[k%] := View() - lh%; k% += 1;
' Print goes where the caret is
View(lh%);
EditSelectAll(); EditClear();
Print("abc");
EditSelectAll();
Print("X");
EditSelectAll(); s$ := Selection$(); Enc(s$, 260);
MoveTo(1, 1);
Print("Y");
EditSelectAll(); s$ := Selection$(); Enc(s$, 270);
a% := FileNew(1);
Print("abc\ndef\n");
MoveTo(1, 1);
Print("Y");
EditSelectAll(); s$ := Selection$(); Enc(s$, 280);
MoveTo(2, 2); MoveBy(1, 0, 1);
Print("%d", 7);
EditSelectAll(); s$ := Selection$(); Enc(s$, 290);
PrintLog("p");
View(lh%);
EditSelectAll(); s$ := Selection$(); Enc(s$, 100);
FileClose(0, -1);
