var res[300], k%, i%, j%, n%, v;
var x[20], y[20], s[20], coef[3], c2[2], f[20][3], cov[3][3], rel[3], a[3][3], b[3][3], c[3][3], inv[3][3], xs[3], ys[3], co[3];
for i% := 0 to 19 do
  x[i%] := i% * 0.5;
  y[i%] := 2.0 + 1.5 * x[i%] - 0.2 * x[i%] * x[i%] + 0.05 * Sin(i% * 2.3);
  s[i%] := 0.1 + 0.01 * i%;
  f[i%][0] := 1.0; f[i%][1] := x[i%]; f[i%][2] := x[i%] * x[i%];
next
k% := 0;
v := FitLinear(coef[], y[], f[][], 0.0, cov[][], rel[]);
res[k%] := v; k% += 1;
for i% := 0 to 2 do res[k%] := coef[i%]; k% += 1; next
for i% := 0 to 2 do res[k%] := rel[i%]; k% += 1; next
for i% := 0 to 2 do for j% := 0 to 2 do res[k%] := cov[i%][j%]; k% += 1; next next
v := FitLinear(coef[], y[], f[][], s[], cov[][]);
res[k%] := v; k% += 1;
for i% := 0 to 2 do res[k%] := coef[i%]; k% += 1; next
v := FitPoly(coef[], y[], x[]);
res[k%] := v; k% += 1;
for i% := 0 to 2 do res[k%] := coef[i%]; k% += 1; next
v := FitPoly(c2[], y[], x[], 0.5);
res[k%] := v; k% += 1;
res[k%] := c2[0]; res[k%+1] := c2[1]; k% += 2;
' matrices
a[0][0] := 4; a[0][1] := 1; a[0][2] := 2;
a[1][0] := 1; a[1][1] := 3; a[1][2] := 0.5;
a[2][0] := 2; a[2][1] := 0.5; a[2][2] := 5;
b[0][0] := 1; b[0][1] := 2; b[0][2] := 3;
b[1][0] := 0; b[1][1] := 1; b[1][2] := 4;
b[2][0] := 5; b[2][1] := 6; b[2][2] := 0;
MATMul(c[][], a[][], b[][]);
for i% := 0 to 2 do for j% := 0 to 2 do res[k%] := c[i%][j%]; k% += 1; next next
res[k%] := MATDet(a[][]); k% += 1;
res[k%] := MATTrace(a[][]); k% += 1;
res[k%] := MATInv(inv[][], a[][]); k% += 1;
for i% := 0 to 2 do for j% := 0 to 2 do res[k%] := inv[i%][j%]; k% += 1; next next
MATTrans(c[][], b[][]);
for i% := 0 to 2 do for j% := 0 to 2 do res[k%] := c[i%][j%]; k% += 1; next next
ys[0] := 1; ys[1] := 2; ys[2] := 3;
res[k%] := MATSolve(xs[], a[][], ys[]); k% += 1;
for i% := 0 to 2 do res[k%] := xs[i%]; k% += 1; next
