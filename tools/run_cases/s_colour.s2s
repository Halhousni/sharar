var res[400], k%, r, g, b, i%, j%;
k% := 0;
for i% := 0 to 39 do
  PaletteGet(i%, r, g, b); res[k%] := r; res[k%+1] := g; res[k%+2] := b; k% += 3;
next
for i% := 0 to 39 do res[k%] := Colour(i%); k% += 1; next
for i% := 0 to 9 do
  res[k%] := ColourGet(1, i%, r, g, b); res[k%+1] := r; res[k%+2] := g; res[k%+3] := b; k% += 4;
next
res[k%] := ColourGet(-1); k% += 1;
res[k%] := ColourGet(0); k% += 1;
res[k%] := ColourGet(1); k% += 1;
